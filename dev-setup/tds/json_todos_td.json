{
    "@context": "https://www.w3.org/2022/wot/td/v1.1",
    "title": "JSON Todos",
    "securityDefinitions": {
        "basic_sc": {
            "scheme": "basic",
            "in": "header"
        }
    },
    "security": "basic_sc",
    "properties": {
        "todos": {
            "type": "object",
            "properties": {
                "userId": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "completed": {
                    "type": "boolean"
                }
            },
            "forms": [
                {
                    "op": "readproperty",
                    "href": "https://jsonplaceholder.typicode.com"
                }
            ],
            "readOnly": true
        }
    }
}